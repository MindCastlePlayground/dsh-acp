{
  "name": "@local/dsh-acp",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "description": "Mount any ACP (Agent Client Protocol) agent as a DeepSeek Harness model route, and inject DSH's tools into it over MCP.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "acp",
    "agent-client-protocol",
    "mcp",
    "model-context-protocol",
    "opencode",
    "claude-code"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "PROTOCOL.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

